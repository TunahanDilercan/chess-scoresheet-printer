<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NotasyonOtomasyonu.Render</RootNamespace>
    <AssemblyName>NotasyonOtomasyonu.Render</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDF üretimi (Community lisans). Akıcı/fluent API. -->
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Türkçe fontlar exe içine GÖMÜLÜR; tek dosya yayında da çalışır. -->
    <EmbeddedResource Include="..\..\assets\fonts\DejaVuSans.ttf">
      <LogicalName>NotasyonOtomasyonu.Render.Fonts.DejaVuSans.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\fonts\DejaVuSans-Bold.ttf">
      <LogicalName>NotasyonOtomasyonu.Render.Fonts.DejaVuSans-Bold.ttf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

</Project>
